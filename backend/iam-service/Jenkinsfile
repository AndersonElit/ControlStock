@Library('controlstock-shared-lib@main') _

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    environment {
        SERVICE_NAME  = "iam-service"
        REGISTRY      = "192.168.122.230:3000/controlstock"
    }

    stages {
        stage('Checkout & Compute Tag') {
            steps {
                checkout scm
                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT?.take(7) ?: 'local'}"
                    echo "IMAGE_TAG=${env.IMAGE_TAG}"
                }
            }
        }

        stage('Build & Unit Tests') {
            steps {
                sh './mvnw -B clean test --batch-mode'
                junit allowEmptyResults: true,
                    testResults: '**/target/surefire-reports/*.xml'
            }
        }

        stage('Integration Tests') {
            steps {
                sh './mvnw -B test -Pintegration --batch-mode || true'
            }
        }

        stage('Quality Gate (SonarQube)') {
            steps {
                echo '[QUALITY] SonarQube no configurado en dev — omitiendo'
            }
        }

        stage('Security Scans') {
            steps {
                echo '[SECURITY] Escaneo no disponible en dev — omitiendo'
            }
        }

        stage('Build & Push Image') {
            steps {
                echo "[IMAGE] Construyendo imagen con Jib..."
                sh "./mvnw -B compile jib:build -pl infrastructure/entry-points/app -Dimage=192.168.122.230:3000/controlstock/iam-service:${env.IMAGE_TAG} --batch-mode"
            }
        }

        stage('Image Scan (Trivy)') {
            steps { echo '[TRIVY] No disponible en dev — omitiendo' }
        }

        stage('Bump Image Tag (GitOps)') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'gitops-git-credentials',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )]) {
                        sh """
                            set -e
                            TMP=\$(mktemp -d)
                            git clone http://\$GIT_USER:\$GIT_PASS@192.168.122.230:3000/controlstock/controlstock-helm-charts.git \$TMP
                            VALUES_FILE="\$TMP/charts/${SERVICE_NAME}/values-dev.yaml"
                            if [ -f "\$VALUES_FILE" ]; then
                                sed -i "s|tag:.*|tag: \\"${env.IMAGE_TAG}\\"|" "\$VALUES_FILE"
                                sed -i "s|repository:.*|repository: \\"${REGISTRY}/${SERVICE_NAME}\\"|" "\$VALUES_FILE"
                                git -C "\$TMP" config user.email "jenkins@ci.local"
                                git -C "\$TMP" config user.name "Jenkins CI"
                                git -C "\$TMP" add "\$VALUES_FILE"
                                git -C "\$TMP" commit -m "ci(${SERVICE_NAME}): bump image to ${env.IMAGE_TAG} [dev]" && git -C "\$TMP" push || echo "[BUMP] Sin cambios que commitear"
                                echo "[BUMP] ${SERVICE_NAME} -> ${REGISTRY}/${SERVICE_NAME}:${env.IMAGE_TAG}"
                            else
                                echo "[BUMP] WARNING: \$VALUES_FILE no existe"
                            fi
                            rm -rf "\$TMP"
                        """
                    }
                }
            }
        }

        stage('Smoke Tests') {
            steps {
                echo "[SMOKE] Verificación placeholder — OK"
            }
        }
    }

    post {
        success {
            echo "[NOTIFY] Pipeline ${SERVICE_NAME}: SUCCESS — Build #${env.BUILD_NUMBER}"
        }
        failure {
            echo "[NOTIFY] Pipeline ${SERVICE_NAME}: FAILURE — Build #${env.BUILD_NUMBER}"
        }
    }
}
