# --- Almacenamiento de objetos S3-compatible ---
# Dev:  MinIO en K3s  (http://minio.infra.svc.cluster.local:9000)
# Prod: OCI Object Storage (https://namespace.compat.objectstorage.region.oraclecloud.com)
STORAGE_ENDPOINT=${STORAGE_ENDPOINT:-http://minio.infra.svc.cluster.local:9000}
STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY:-minioadmin}
STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY:-changeme_minio}
REPORT_BUCKET=${REPORT_BUCKET:-controlstock-reports}
# --- Kafka (K3s via Strimzi) ---
KAFKA_BOOTSTRAP_SERVERS=kafka-kafka-bootstrap.messaging.svc.cluster.local:9092
# --- BD de reportería propia de MS1 (<prefix>_reporting) ---
# Contiene report_schema_catalog: catálogo de esquemas para validación.
REPORTING_JDBC_URL=jdbc:postgresql://postgresql.data.svc.cluster.local:5432/controlstock_reporting
REPORTING_JDBC_USER=controlstock_reporting_user
REPORTING_JDBC_PASSWORD=changeme_controlstock_reporting
# --- Read model CQRS (MongoDB en K3s) — SOLO LECTURA ---
MONGO_URI=mongodb://mongodb.data.svc.cluster.local:27017
MONGO_READ_DB=readmodel
MONGO_READ_COLLECTION=ventas
