@Library('controlstock-shared-lib@main') _

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    environment {
        SERVICE_NAME  = "report-etl-service"
    }

    stages {
        stage('Checkout & Compute Tag') {
            steps {
                checkout scm
                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT?.take(7) ?: 'local'}"
                }
            }
        }

        stage('Build & Unit Tests (Scala/SBT)') {
            steps {
                sh 'sbt clean test'
            }
        }

        stage('Assembly (Fat JAR)') {
            steps {
                sh 'sbt assembly'
            }
        }

        stage('Quality Gate') { steps { echo '[QUALITY] No configurado en dev' } }
        stage('Security Scans') { steps { echo '[SECURITY] No disponible en dev' } }
        stage('Image Scan') { steps { echo '[TRIVY] No disponible en dev' } }
        stage('Smoke Tests') { steps { echo '[SMOKE] OK' } }
    }

    post {
        success { echo "[NOTIFY] Pipeline report-etl-service: SUCCESS" }
        failure { echo "[NOTIFY] Pipeline report-etl-service: FAILURE" }
    }
}
